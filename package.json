{
  "name": "ScottyApp",
  "version": "0.1.0-alpha",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "build:android:debug": "cd android && ./gradlew assembleDebug",
    "build:android:release": "cd android && ./gradlew assembleRelease",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,js}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js}'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "detox test --configuration android.emu.debug",
    "test:e2e:build": "detox build --configuration android.emu.debug",
    "test:playwright": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.85.1",
    "@react-native/new-app-screen": "0.85.1",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "react-native-screens": "^4.4.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-gesture-handler": "^2.21.2",
    "react-native-reanimated": "^3.16.7",
    "@shopify/flash-list": "^1.7.3",
    "react-native-svg": "^15.11.2",
    "phosphor-react-native": "^2.2.1",
    "react-native-markdown-display": "^7.0.2",
    "zustand": "^5.0.3",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "react-native-mmkv": "^3.2.0",
    "@supabase/supabase-js": "^2.47.12",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-audio-recorder-player": "^3.6.10",
    "react-native-permissions": "^5.3.1",
    "react-native-haptic-feedback": "^2.3.1",
    "react-native-linear-gradient": "^2.8.3",
    "@react-native-community/slider": "^4.5.5",
    "date-fns": "^4.1.0",
    "react-native-device-info": "^14.0.4",
    "@react-native-community/netinfo": "^11.4.1",
    "react-native-animatable": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.1",
    "@react-native/eslint-config": "0.85.1",
    "@react-native/jest-preset": "0.85.1",
    "@react-native/metro-config": "0.85.1",
    "@react-native/typescript-config": "0.85.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-native": "^4.1.0",
    "@testing-library/react-native": "^12.9.0",
    "@testing-library/jest-native": "^5.4.3",
    "jest": "^29.7.0",
    "babel-jest": "^29.7.0",
    "react-test-renderer": "19.2.3",
    "prettier": "^3.4.2",
    "typescript": "5.0.4",
    "@playwright/test": "^1.49.1",
    "detox": "^20.26.3"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "setupFilesAfterFramework": [
      "@testing-library/jest-native/extend-expect"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@react-navigation|phosphor-react-native|react-native-reanimated|react-native-gesture-handler|@shopify/flash-list|react-native-svg|react-native-mmkv|react-native-permissions|react-native-haptic-feedback|react-native-linear-gradient|@react-native-community|react-native-device-info|react-native-animatable|react-native-markdown-display|react-native-audio-recorder-player)/)"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|webp|svg)$": "<rootDir>/src/__mocks__/fileMock.js"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**",
      "!src/**/index.ts"
    ]
  },
  "detox": {
    "testRunner": {
      "args": {
        "$0": "jest",
        "config": "e2e/jest.config.js"
      },
      "jest": {
        "setupTimeout": 120000
      }
    },
    "apps": {
      "android.debug": {
        "type": "android.apk",
        "binaryPath": "android/app/build/outputs/apk/debug/app-debug.apk",
        "build": "cd android && ./gradlew assembleDebug assembleAndroidTest -DtestBuildType=debug"
      }
    },
    "devices": {
      "emulator": {
        "type": "android.emulator",
        "device": {
          "avdName": "Pixel_4_API_31"
        }
      }
    },
    "configurations": {
      "android.emu.debug": {
        "device": "emulator",
        "app": "android.debug"
      }
    }
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
